# =====================================================================
# XAUUSD Scalper - configuracion local. Copia este archivo a ".env" y
# rellena tus datos. ".env" NUNCA se sube a git (ver .gitignore).
# =====================================================================

# ---- Credenciales MT5 / FBS ----
# Se piden tambien de forma interactiva la primera vez que corres run.sh
# si este archivo no existe todavia.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FBS-Demo
MT5_IS_DEMO=true

# ---- Broker: por que via se conecta el motor ----
# "mt5_bridge" (default): via el bridge Wine/MT5 de abajo - sirve para
#   CUALQUIER broker MT5 (FBS incluido; FBS no tiene API REST publica,
#   asi que para FBS este es el unico camino honesto).
# "oanda": conexion DIRECTA a OANDA por su API REST v20 - sin MetaTrader,
#   sin Wine, sin bridge, sin segunda maquina. Funciona igual en Termux/
#   Kali/Ubuntu (HTTPS puro). Crea una cuenta practice gratis en
#   oanda.com, genera un token en "Manage API Access" y completa:
BROKER_KIND=mt5_bridge
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# "practice" (demo, recomendado para empezar) o "live" (dinero real).
OANDA_ENV=practice

# ---- Bridge (proceso Wine que habla con el terminal MT5) ----
# Solo aplica con BROKER_KIND=mt5_bridge.
#
# Donde esta el MetaTrader 5 de esta maquina. VACIO (default) = deteccion
# automatica: primero el prefijo del proyecto (.wine, creado por
# install.sh), despues una instalacion del sistema (el lanzador
# `metatrader` del instalador oficial de MetaQuotes para Linux, o
# ~/.wine | ~/.mt5). El bridge corre en el MISMO prefijo Wine que el
# terminal (es un requisito tecnico del paquete MetaTrader5, no una
# preferencia) - si tu MT5 esta en una ruta rara, fijalos aca:
MT5_WINEPREFIX=
MT5_TERMINAL_PATH=
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_BRIDGE_TIMEOUT_MS=8000
# Token compartido que el bridge exige en cada pedido (excepto /health) via
# el header X-Bridge-Token. install.sh lo genera solo - no hace falta
# tocarlo a mano. El bridge SIGUE atado a 127.0.0.1 por defecto (esa es la
# proteccion principal); esto es una segunda capa por si algun dia ese
# binding cambia sin querer, ya que esta API puede abrir/cerrar operaciones
# reales.
BRIDGE_AUTH_TOKEN=
# En que interfaz ESCUCHA el bridge local (solo aplica en la maquina
# Kali/Ubuntu que corre Wine, Termux nunca levanta bridge local).
# 127.0.0.1 (default) = solo esta maquina. Si un telefono Termux u otra
# maquina va a usar ESTE bridge como remoto (su MT5_BRIDGE_URL apuntando
# aca), cambialo a 0.0.0.0 - sin esto, el bridge es inalcanzable desde
# afuera y la conexion remota NO puede funcionar. El token de arriba se
# exige en cada pedido igualmente (run.sh ademas avisa fuerte si abris el
# binding sin token configurado), y para redes que no controlas el README
# documenta como montar el enlace sobre un tunel SSH o VPN.
BRIDGE_BIND_HOST=127.0.0.1

# Interruptor de emergencia manual: si este archivo existe, el motor cierra
# a mercado cualquier posicion abierta en el proximo ciclo y se detiene (no
# se reinicia solo - ver main.py/run.sh). Se revisa en cada paso, sin
# depender de acceso por terminal a la maquina: alcanza con crear el
# archivo (touch data/EMERGENCY_STOP) desde cualquier cosa que pueda
# escribir al filesystem. Para reanudar: borralo junto con
# data/run/stop.flag y corre ./run.sh de nuevo.
KILL_SWITCH_PATH=data/EMERGENCY_STOP

# Pausa manual (distinta del interruptor de emergencia de arriba): mientras
# este archivo existe, el motor deja de abrir operaciones NUEVAS pero sigue
# protegiendo/gestionando cualquier posicion ya abierta y sigue corriendo
# (no se detiene el proceso). Reversible al instante con solo borrar el
# archivo - la maneja el boton "Detener bot"/"Reanudar bot" del dashboard.
PAUSE_FLAG_PATH=data/PAUSED

# Token compartido que el dashboard exige (header X-Dashboard-Token) en sus
# rutas que modifican algo (guardar Settings, pausar/reanudar) cuando esta
# configurado - install.sh lo genera solo. Las rutas de solo lectura NO lo
# piden. Importa sobre todo si corres el dashboard con
# `--web --host 0.0.0.0` (accesible desde tu red local) - sin token, cualquier
# dispositivo en esa red podria cambiar la cuenta/password guardada o
# pausar el bot.
DASHBOARD_AUTH_TOKEN=

# Cada cuantos segundos el motor pide precio/velas nuevas y revisa posiciones
# abiertas. Mas bajo = reacciona mas rapido a movimientos de precio (importa
# sobre todo para no regalar ganancias entre niveles de TP). Piso real: cada
# poll es un viaje redondo por el bridge de Wine - bajar de ~0.5s en hardware
# tipico solo significa que la mayoria de los polls devuelven el mismo tick
# porque el broker todavia no genero uno nuevo, no velocidad real extra.
POLL_SECONDS=2.0

# ---- Instrumento / temporalidad ----
SYMBOL=XAUUSD
TIMEFRAME=M1

# ---- Gestion de riesgo (todo esto es real, no cosmetico) ----
# Riesgo maximo en USD que el bot esta dispuesto a perder en UN trade.
# 3.0, no 1.0 (Ronda 6, ver README): a precios reales de oro (~$4000) el
# lote minimo del broker (0.01) con un stop basado en ATR real ya arriesga
# varios dolares - con RISK_PER_TRADE_USD=1.0 el filtro de seguridad de
# core/risk_manager.py (correcto, no es un bug) rechaza PRACTICAMENTE TODA
# señal, confirmado en datos reales frescos: 0 operaciones en 5.5 dias
# completos, en ambas mitades de un split train/test. 3.0 es el piso mas
# bajo donde el bot realmente opera con un comportamiento consistente
# entre train y test (ver README) - esto NO es una afirmacion de
# rentabilidad, sigue siendo levemente negativo en ambos tramos. Es
# simplemente el piso para que el bot pueda operar en absoluto hoy.
RISK_PER_TRADE_USD=3.0
# Perdida maxima acumulada en el dia antes de que el bot se detenga solo.
MAX_DAILY_LOSS_USD=8.0
# Drawdown maximo sobre el balance inicial del dia antes de detenerse.
MAX_DAILY_DRAWDOWN_PCT=20.0
# Limite superior de trades/dia. El motor puede parar antes por margen o riesgo.
MAX_TRADES_PER_DAY=1000
# Ganancia objetivo del primer escalon de TP (USD), el resto escala desde aqui.
MIN_TP_USD=0.28
# Numero de escalones de take-profit (cierre parcial en cada uno). 5 (no 3)
# es el default desde la Ronda 5 del backtest (ver README): con el ladder
# adaptativo a la volatilidad, 5 escalones le fue mucho mejor a la
# reversion a la media que 3 (-$0.13 contra -$0.95 sobre los mismos 7 dias
# reales) - mas cortes = mas capital que sale en distintos niveles del
# camino de vuelta hacia el promedio en vez de solo 3 tajadas.
TP_LEVELS=5
# Opcional: objetivo de ganancia EXPLICITO en USD para cada escalon de TP,
# separados por coma (debe tener TP_LEVELS valores, o se repite el ultimo).
# Ejemplo con TP_LEVELS=3: TP_TARGETS_USD=0.28,0.60,1.20 hace que cada
# escalon reserve su propio monto en dolares en vez de que solo el primero
# (MIN_TP_USD) tenga un valor en dolares y el resto sean multiplos de
# precio derivados de ese primero. Vacio (default) = comportamiento
# original, ya validado en el backtest de este README - no lo actives sin
# entender que cambia los niveles de salida reales.
TP_TARGETS_USD=

# ---- Ajuste de la estrategia (opcional - estos son los valores por defecto) ----
# Señal: reversion a la media con Bandas de Bollinger + RSI en el extremo.
# Tocar esto SIN backtestear primero es apostar a ciegas.
STRAT_RSI_OVERSOLD=25.0
STRAT_RSI_OVERBOUGHT=75.0
STRAT_BB_PERIOD=20
STRAT_BB_STD=2.0
STRAT_RSI_PERIOD=7
STRAT_ATR_PERIOD=14
# Spread maximo (en precio) para aceptar una señal - si el spread esta mas
# ancho que esto, cualquier setup se descarta (no vale la pena perseguirlo).
STRAT_MAX_SPREAD_PRICE=0.5
# ATR minimo para considerar que hay suficiente movimiento para que el
# primer TP tenga sentido frente al spread.
STRAT_MIN_ATR_PRICE=0.15
# Distancia del stop loss = ATR * este multiplicador (con un piso basado
# en MIN_TP_USD, ver core/strategy.py). 4.0 viene de backtesting real
# (COMEX gold 1m, train/test 60/40) - valores mas bajos (~1.2) dejan el
# stop demasiado cerca del ruido normal de 1m y pierden dinero; ver el
# docstring de core/strategy.py para el detalle completo.
STRAT_SL_ATR_MULTIPLE=4.0
# Velas de 1m que hay que esperar tras cerrar un trade antes de aceptar
# la siguiente señal (evita reentrar en el mismo ruido inmediatamente).
STRAT_COOLDOWN_BARS=2
# Filtro de tendencia (ADX): si ADX >= este umbral, el mercado esta en
# tendencia fuerte y se descarta cualquier señal de reversion a la media
# (fue precisamente fadear una tendencia fuerte lo que produjo la secuencia
# de perdidas que quebro la cuenta en el backtest de 8 dias - ver README).
STRAT_ADX_PERIOD=14
STRAT_TREND_FILTER_ADX_THRESHOLD=35.0

# ---- Señales extra (opcionales, TODAS apagadas por defecto) ----
# Cinco señales M1 independientes mas, ademas de la reversion a la media de
# arriba - ideas adaptadas de un EA de referencia que me pasaron (ver el
# docstring de core/signals.py para el detalle completo de que se adapto y
# que se descarto a proposito: nada de grid/martingale sin stop-loss, cada
# señal de aca pasa por el mismo RiskManager y el mismo limite de
# RISK_PER_TRADE_USD que la reversion a la media, sin excepciones).
#
# Por que estan apagadas: un backtest real (7 dias de oro COMEX 1m, ver
# README "Ronda 4") encontro que las 5, cada una por separado, SI logran
# el objetivo de mas operaciones/dia (hasta ~26/dia contra ~3/dia de la
# reversion sola) pero con un resultado en dolares peor, no mejor, que la
# reversion a la media sola. Quedan en el codigo, probadas y documentadas,
# para quien quiera activar una, ajustarla y volver a correr el backtest -
# no para usarlas tal cual en una cuenta real todavia.
STRAT_ENABLE_MOMENTUM_CROSS=false
STRAT_ENABLE_RSI_HYSTERESIS=false
STRAT_ENABLE_DIRECTIONAL_CANDLE=false
STRAT_ENABLE_SESSION_OPEN=false
STRAT_ENABLE_ASIAN_BREAKOUT=false

# Sexta señal extra, NO adaptada del EA de referencia - pedida directamente
# por el usuario para sumar frecuencia de trades: mira la ULTIMA vela M15 ya
# CERRADA (resample de M1, nunca la vela M15 en formacion - mismo principio
# de "solo velas cerradas" que la Ronda 8 ya aplico a M1) y usa su cierre vs
# apertura como contexto de compra/venta para M1. Backtest real (ver README
# "Ronda 9"): default queda en false, ver esa seccion para el numero exacto
# y por que.
STRAT_ENABLE_M15_TREND=false

# RSI/ATR usados SOLO por las señales extra de arriba (no tocan
# STRAT_RSI_PERIOD/STRAT_ATR_PERIOD, que son de la reversion a la media).
STRAT_COMPOSITE_RSI_PERIOD=14
STRAT_COMPOSITE_ATR_PERIOD=14

STRAT_MOMENTUM_SL_ATR_MULTIPLE=2.0

STRAT_RSI_HYSTERESIS_SL_ATR_MULTIPLE=2.0
STRAT_RSI_HYSTERESIS_UPPER=52.0
STRAT_RSI_HYSTERESIS_LOWER=48.0

STRAT_DIRECTIONAL_CANDLE_SL_BUFFER_ATR_MULT=0.3

# Ventanas de sesion en hora UTC (Londres y Nueva York) para
# STRAT_ENABLE_SESSION_OPEN.
STRAT_SESSION_SL_ATR_MULTIPLE=2.0
STRAT_SESSION_LONDON_START_HOUR=7
STRAT_SESSION_LONDON_END_HOUR=10
STRAT_SESSION_NY_START_HOUR=12
STRAT_SESSION_NY_END_HOUR=16

# Rango asiatico (para armar el rango) y ventana de ruptura (para operarla),
# en hora UTC, para STRAT_ENABLE_ASIAN_BREAKOUT.
STRAT_ASIAN_SL_ATR_MULTIPLE=2.0
STRAT_ASIAN_RANGE_START_HOUR=0
STRAT_ASIAN_RANGE_END_HOUR=7
STRAT_ASIAN_BREAKOUT_START_HOUR=7
STRAT_ASIAN_BREAKOUT_END_HOUR=10
STRAT_ASIAN_BREAKOUT_BUFFER_PCT=0.05

# Para STRAT_ENABLE_M15_TREND: multiplicador de ATR (M1) para el stop, y que
# tan chico puede ser el cuerpo de la vela M15 (como fraccion de su rango
# high-low) antes de tratarla como doji/lateral y no dar señal.
STRAT_M15_TREND_SL_ATR_MULTIPLE=2.0
STRAT_M15_TREND_MIN_BODY_RANGE_RATIO=0.1

# Septima señal extra: SMA(9)/SMA(26) cross + espera fija de 2 velas + filtro
# RSI permisivo (70/30), portada de un EA MQL5 que paso el usuario
# ("ScalpMaster Pro v1.0") pidiendo portarlo "tal cual". El original abre
# posiciones con SL=0 (sin stop-loss real, solo un trailing que arranca
# recien despues de tocar el primer nivel de su grid de TP) - eso NO se
# porto, se le agrego un SL real basado en ATR (ver core/signals.py,
# MACrossGridStrategy). Pensada para velas M15 nativas, no M1 (ver README
# "Ronda 10" para el resultado real del backtest antes de activarla).
STRAT_ENABLE_MA_GRID=false
STRAT_MA_GRID_SL_ATR_MULTIPLE=3.0
STRAT_MA_GRID_FAST_PERIOD=9
STRAT_MA_GRID_SLOW_PERIOD=26
STRAT_MA_GRID_ENTRY_WAIT_BARS=2
STRAT_MA_GRID_RSI_OVERBOUGHT=70.0
STRAT_MA_GRID_RSI_OVERSOLD=30.0
# ADX(14) minimo para permitir un cruce (0 = sin filtro). Un cruce de SMA es
# señal de TENDENCIA - sin este filtro dispara igual en mercado lateral/ruido
# y eso es exactamente lo que lo hundio en M1 real (ver README "Ronda 11":
# -$29.24 con 78.4% de acierto, ganancia promedio +$0.14 vs perdida promedio
# -$3.54). ADX>=20 no lo vuelve rentable en M1 (sigue perdiendo en TEST) pero
# reduce perdida y drawdown ~5-6x de forma honesta y medida - no es una
# solucion completa, es una reduccion de riesgo real.
STRAT_MA_GRID_MIN_ADX=20.0

# Cuantas velas M1 pide el motor al bridge en cada poll. 200 alcanzaba solo
# para la reversion a la media; las señales extra de arriba (EMA50 en M5,
# rango asiatico) necesitan varias horas de historial para calentar bien -
# sigue siendo UN solo pedido al bridge por poll, nomas con mas datos.
CANDLE_HISTORY_COUNT=600

# ---- Modo de ejecucion ----
# true  = no envia ordenes reales, solo simula con precios en vivo/backtest.
# false = envia ordenes reales a la cuenta configurada arriba.
DRY_RUN=true

# ---- Dashboard ----
DASHBOARD_DB_PATH=data/trades.db

# Cuantos dias de account_snapshots (una fila por cada poll del motor, no
# solo por operacion) se conservan antes de que el motor los borre solos
# (chequeo cada una hora). Sin esto la tabla crece sin limite en una
# instancia que corre semanas/meses.
SNAPSHOT_RETENTION_DAYS=30
