# =====================================================================
# XAUUSD Scalper - configuracion local. Copia este archivo a ".env" y
# rellena tus datos. ".env" NUNCA se sube a git (ver .gitignore).
# =====================================================================

# ---- Credenciales MT5 / FBS ----
# Se piden tambien de forma interactiva la primera vez que corres run.sh
# si este archivo no existe todavia.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FBS-Demo
MT5_IS_DEMO=true

# ---- Broker: por que via se conecta el motor ----
# "mt5_bridge" (default): via el bridge Wine/MT5 de abajo - sirve para
#   CUALQUIER broker MT5 (FBS incluido; FBS no tiene API REST publica,
#   asi que para FBS este es el unico camino honesto).
# "oanda": conexion DIRECTA a OANDA por su API REST v20 - sin MetaTrader,
#   sin Wine, sin bridge, sin segunda maquina. Funciona igual en cualquier
#   instalacion Linux (HTTPS puro). Crea una cuenta practice gratis en
#   oanda.com, genera un token en "Manage API Access" y completa:
BROKER_KIND=mt5_bridge
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# "practice" (demo, recomendado para empezar) o "live" (dinero real).
OANDA_ENV=practice

# ---- Bridge (proceso Wine que habla con el terminal MT5) ----
# Solo aplica con BROKER_KIND=mt5_bridge.
#
# Donde esta el MetaTrader 5 de esta maquina. VACIO (default) = deteccion
# automatica: primero el prefijo del proyecto (.wine, creado por
# install.sh), despues una instalacion del sistema (el lanzador
# `metatrader` del instalador oficial de MetaQuotes para Linux, o
# ~/.wine | ~/.mt5). El bridge corre en el MISMO prefijo Wine que el
# terminal (es un requisito tecnico del paquete MetaTrader5, no una
# preferencia) - si tu MT5 esta en una ruta rara, fijalos aca:
MT5_WINEPREFIX=
MT5_TERMINAL_PATH=
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_BRIDGE_TIMEOUT_MS=8000
# Token compartido que el bridge exige en cada pedido (excepto /health) via
# el header X-Bridge-Token. install.sh lo genera solo - no hace falta
# tocarlo a mano. El bridge SIGUE atado a 127.0.0.1 por defecto (esa es la
# proteccion principal); esto es una segunda capa por si algun dia ese
# binding cambia sin querer, ya que esta API puede abrir/cerrar operaciones
# reales.
BRIDGE_AUTH_TOKEN=
# En que interfaz ESCUCHA el bridge local (solo aplica en la maquina
# Kali/Ubuntu que corre Wine).
# 127.0.0.1 (default) = solo esta maquina. Si otra maquina Linux
# va a usar ESTE bridge como remoto (su MT5_BRIDGE_URL apuntando
# aca), cambialo a 0.0.0.0 - sin esto, el bridge es inalcanzable desde
# afuera y la conexion remota NO puede funcionar. El token de arriba se
# exige en cada pedido igualmente (run.sh ademas avisa fuerte si abris el
# binding sin token configurado), y para redes que no controlas el README
# documenta como montar el enlace sobre un tunel SSH o VPN.
BRIDGE_BIND_HOST=127.0.0.1

# Interruptor de emergencia manual: si este archivo existe, el motor cierra
# a mercado cualquier posicion abierta en el proximo ciclo y se detiene (no
# se reinicia solo - ver main.py/run.sh). Se revisa en cada paso, sin
# depender de acceso por terminal a la maquina: alcanza con crear el
# archivo (touch data/EMERGENCY_STOP) desde cualquier cosa que pueda
# escribir al filesystem. Para reanudar: borralo junto con
# data/run/stop.flag y corre ./run.sh de nuevo.
KILL_SWITCH_PATH=data/EMERGENCY_STOP

# Pausa manual (distinta del interruptor de emergencia de arriba): mientras
# este archivo existe, el motor deja de abrir operaciones NUEVAS pero sigue
# protegiendo/gestionando cualquier posicion ya abierta y sigue corriendo
# (no se detiene el proceso). Reversible al instante con solo borrar el
# archivo - la maneja el boton "Detener bot"/"Reanudar bot" del dashboard.
PAUSE_FLAG_PATH=data/PAUSED

# Token compartido que el dashboard exige (header X-Dashboard-Token) en sus
# rutas que modifican algo (guardar Settings, pausar/reanudar) cuando esta
# configurado - install.sh lo genera solo. Las rutas de solo lectura NO lo
# piden. Importa sobre todo si corres el dashboard con
# `--web --host 0.0.0.0` (accesible desde tu red local) - sin token, cualquier
# dispositivo en esa red podria cambiar la cuenta/password guardada o
# pausar el bot.
DASHBOARD_AUTH_TOKEN=

# Cada cuantos segundos el motor pide precio/velas nuevas y revisa posiciones
# abiertas. Mas bajo = reacciona mas rapido a movimientos de precio (importa
# sobre todo para no regalar ganancias entre niveles de TP). Piso real: cada
# poll es un viaje redondo por el bridge de Wine - bajar de ~0.5s en hardware
# tipico solo significa que la mayoria de los polls devuelven el mismo tick
# porque el broker todavia no genero uno nuevo, no velocidad real extra.
POLL_SECONDS=2.0

# ---- Instrumento / temporalidad ----
SYMBOL=XAUUSD
TIMEFRAME=M1

# ---- Confluencia, régimen y cesta opcional (todo apagado por defecto) ----
# QuantumQueenVoteStrategy nunca habia sido medida en un backtest propio
# (core/quantum_queen.py) hasta la Ronda 14: mismo split TRAIN/TEST y mismos
# parametros de riesgo que las 5 señales de mas abajo (reversion a la media
# + quantum_queen SOLA, nada mas). Resultado: 75 trades TRAIN -$19.13 (44.8%
# dd), 70 trades TEST -$11.59 (30.8% dd) - win rate alto (71-76%) pero
# pierde dinero en ambas mitades, mismo patron que las otras 6 señales
# extra de este archivo. Queda apagada.
STRAT_ENABLE_QUANTUM_QUEEN=false
STRAT_QUANTUM_PRIMARY=false
STRAT_QUANTUM_THRESHOLD=2
STRAT_QUANTUM_MASK=4095
REGIME_FILTER_ENABLED=true
REGIME_ADX_TREND_THRESHOLD=25
REGIME_ATR_RATIO_HIGH=1.35
REGIME_ATR_RATIO_LOW=0.65
# GRID_ENABLED permite como máximo GRID_MAX_POSITIONS posiciones; cada una
# vuelve a pasar por RiskManager. RECOVERY_ENABLED permite promediar sólo en
# rango y hasta RECOVERY_MAX_LEVELS; mantenerlo false en cuentas pequeñas.
GRID_ENABLED=false
GRID_MAX_POSITIONS=3
GRID_STEP_ATR=1.0
GRID_LOT_MULTIPLIER=1.0
GRID_MAX_LOT=0.09
RECOVERY_ENABLED=false
RECOVERY_MAX_LEVELS=2
RECOVERY_MIN_REGIME=range
DYNAMIC_LOT_CAP=0.09

# ---- Gestion de riesgo (todo esto es real, no cosmetico) ----
# Riesgo maximo en USD que el bot esta dispuesto a perder en UN trade.
# Historia de este valor (ver README):
# - 1.0: el filtro de seguridad de core/risk_manager.py (correcto, no bug)
#   rechaza practicamente toda señal a precios reales de oro (~$4000) -
#   0 operaciones en 5.5 dias completos, confirmado en datos reales.
# - 3.0 (Ronda 6): el piso mas bajo donde el bot opera con comportamiento
#   consistente entre train/test - pero eso NO era una afirmacion de
#   rentabilidad, solo "opera en absoluto".
# - 6.0 (Ronda 12): barrido completo de RISK_PER_TRADE_USD (3 a 8) sobre
#   7839 velas M1 reales con split TRAIN/TEST 60/40 - unico valor con PnL
#   positivo en AMBAS mitades a la vez que maximiza trades/dia (TRAIN
#   +$3.31/28.4% dd/~31 trades/dia, TEST +$22.52/11.9% dd/~32 trades/dia).
#   8.0 ya rompe (TRAIN -$5.89, 47.5% dd) - ese es el borde real medido.
# - Ronda 16: re-barrido {2,3,4,5,6,8} sobre data/gold_m1_7d_{train,test}.csv
#   (el dataset chico de 7 dias, no el de 7839 velas de Ronda 12) con el
#   STRAT_SL_ATR_MULTIPLE=3.5 de Ronda 15 y el cap de Ronda 13 ya vigentes.
#   Resultado inesperado: 3, 4, 5, 6 y 8 dan EXACTAMENTE el mismo backtest
#   (TRAIN 8 trades +$2.04/5.8% dd, TEST 9 trades +$2.76/6.3% dd) - el cap
#   de Ronda 13 (MAX_RISK_FRACTION_OF_BALANCE=5%, core/risk_manager.py) se
#   activa primero para CUALQUIER RISK_PER_TRADE_USD nominal por encima de
#   balance*0.05 (con balance=$50, eso es $2.50), asi que el riesgo real
#   usado en sizing queda fijo en $2.50 sin importar si el .env dice 3.0 o
#   8.0 - Ronda 12 midio ese rango ANTES de que el cap de Ronda 13
#   existiera, por eso encontro diferencias reales entre 3 y 8 que hoy ya
#   no existen a este tamano de cuenta. Confirmado el punto de quiebre:
#   2.5 en TRAIN todavia da el mismo resultado (el cap tambien aplica
#   justo en 2.5) pero en TEST cae a 4 trades/-$1.42 (24.5% dd) - a partir
#   de ~2.6 vuelve a los mismos +9 trades/+$2.76 de 3.0 en adelante; 2.0
#   (por debajo del cap, sin capar) da solo 1 trade/+$0.67-0.85 en ambas
#   mitades - ni mejor ni comparable en muestra. Ningun valor de {2,3,4,5,
#   6,8} mejora de forma real y sostenida sobre el default actual (6.0
#   empata con 3-8) asi que el numero NO se toca esta ronda - pero el
#   valor nominal es hoy en gran parte cosmetico mientras balance este
#   cerca de $50: lo que de verdad determina el riesgo por trade a este
#   tamano de cuenta es el cap del 5% de Ronda 13, no este numero, y eso
#   solo deja de ser cierto si el balance crece bastante (a partir de
#   balance > RISK_PER_TRADE_USD/0.05, p.ej. balance>120 para 6.0, el cap
#   deja de ganarle al valor nominal).
# - Ronda 25 (2026-07-24): re-verificado el hallazgo de Ronda 16 con la
#   config vigente hoy (MIN_TP_USD=0.60/TP_LEVELS=8 de Rondas 20/22,
#   STRAT_ENABLE_MA_GRID=true de Ronda 21, todos posteriores a Ronda 16).
#   Sobre data/gold_m1_7d_{train,test}.csv, balance=$50 (igual que Ronda
#   16): TEST sigue empatado 3-8 (15 trades/+$4.02, solo 2.0 difiere) -
#   el hallazgo de Ronda 16 se sostiene ahi. Pero TRAIN YA NO empata: 3.0
#   da 25 trades/+$13.94/6.9% dd, mientras 4,5,6,8 dan 27 trades/+$10.73/
#   14.2% dd (identicos entre si) - risk_usd=3.0 (el default real de
#   .env, no el 6.0 de este archivo) es hoy estrictamente MEJOR que 4-8
#   en TRAIN, ya no cosmetico ahi. Causa: risk_budget=min(risk_per_trade_
#   usd, balance*0.05) en core/risk_manager.py::size_position() - a
#   balance FIJO en 50 esa cuenta daba identico para cualquier nominal
#   >=2.5 (Ronda 16), pero el config nuevo genera suficientes trades
#   ganadores en TRAIN para que el balance COMPONGA por encima de 60 a
#   mitad de la corrida; ahi balance*0.05 supera 3.0 y el cap deja de
#   aplicar para risk_usd=3 (usa el nominal 3.0 fijo), mientras que para
#   4/5/6/8 el cap (balance*0.05, todavia creciendo) sigue ganandole al
#   nominal mas tiempo - lotes ligeramente distintos que terminan
#   aceptando/rechazando señales distintas mas adelante (un set de
#   trades DISTINTO, 25 vs 27, no solo PnL distinto sobre el mismo set).
#   No se cambia nada: 3.0 ya es el default real y ya es el mejor de los
#   6 valores en TRAIN, empatando en TEST. A balance real de la cuenta
#   (~$20, cap=$1.00) TODOS los valores {2,3,4,5,6,8} dan 0 trades por
#   igual (mismo techo estructural de Rondas 23/24, aca rechaza el 100%)
#   - a ese balance real el numero SI sigue siendo irrelevante en la
#   practica, porque nada opera todavia a ese tamaño de cuenta.
RISK_PER_TRADE_USD=6.0
# Perdida maxima acumulada en el dia antes de que el bot se detenga solo.
MAX_DAILY_LOSS_USD=8.0
# Drawdown maximo sobre el balance inicial del dia antes de detenerse.
MAX_DAILY_DRAWDOWN_PCT=20.0
# Limite superior de trades/dia. El motor puede parar antes por margen o riesgo.
MAX_TRADES_PER_DAY=1000
# Ganancia objetivo del primer escalon de TP (USD), el resto escala desde aqui.
# Historia de este valor:
# - 0.28 (backtest original, ver README/git log de Fase 1): nunca fue barrido
#   por si solo, solo heredado.
# - Ronda 20 (2026-07-24): las Rondas 14/17/19 (ver "Señales extra" mas abajo)
#   encontraron el mismo techo estructural tres veces con señales distintas -
#   el ladder de TP anclado en 0.28 mientras el SL real es
#   max(atr*STRAT_SL_ATR_MULTIPLE, 1.5x la distancia de TP1) exige un win rate
#   muy alto y sostenido, porque cada perdida es >=1.5x mas grande que la
#   ganancia tipica. En vez de otra señal nueva, esta ronda ataca esa relacion
#   directamente subiendo MIN_TP_USD (build_strategy_from_settings, señal SOLA
#   = reversion a la media, sin ninguna señal extra prendida, mismos
#   parametros de riesgo vigentes: RISK_PER_TRADE_USD=6.0 -> capado a $2.50 por
#   el 5% de Ronda 13, STRAT_SL_ATR_MULTIPLE=3.5, TP_LEVELS=5).
#   Diagnostico previo (core/strategy.py::ScalpStrategy.generate_signal): al
#   lote real que usa esta cuenta (0.01-0.03), atr*3.5 SIEMPRE domina el
#   max(...) sobre el rango de MIN_TP_USD barrido (0.28-2.20) - el piso de
#   1.5xTP1 nunca se activa aca, asi que subir MIN_TP_USD en este rango NO
#   ensancha el SL, solo agranda el TP - una mejora directa y limpia del
#   ratio, no un canje riesgo-por-riesgo. (El piso SI puede activarse para las
#   señales extra de core/signals.py, que usan un SL estructural propio en vez
#   de atr*3.5 - no medido en detalle esta ronda, ver Rondas 14/17/19.)
#   Barrido real sobre data/gold_m1_7d_{train,test}.csv (60/40 split real,
#   7 dias M1): en TRAIN, 0.28->0.80 sube el PnL de forma monotona SIN
#   cambiar el patron de trades/aciertos (siempre 8 trades, 7 ganadores,
#   87.5% acierto - solo crece el monto de cada TP), hasta un quiebre exacto
#   entre 0.80 y 0.82 donde un ganador se vuelve perdedor (TRAIN se da vuelta
#   a -$0.69/-$0.74, 75% acierto). Se eligio 0.60 - adentro de la zona estable
#   con margen real (~25%) contra ese quiebre, no el maximo local:
#     TRAIN: 8 trades, 87.5% acierto, PnL +$3.67 (vs +$2.04 del default viejo)
#     TEST:  12 trades, 91.7% acierto, PnL +$8.73 (vs +$2.76 del default viejo)
#   Mejora en AMBAS mitades, sin cambiar el patron de trades de TRAIN (mismo
#   riesgo, ganancias mas grandes) y con MAS trades y MAS acierto en TEST (el
#   TP mas grande deja pasar señales que antes quedaban fuera de cooldown por
#   trades mas cortos) - no es un numero elegido a dedo sobre TEST, la zona
#   0.50-0.70 completa es estable en ambas mitades. Reversion a la media SOLA
#   confirmada como control explicito antes/despues (arriba). Nuevo default:
MIN_TP_USD=0.60
# Numero de escalones de take-profit (cierre parcial en cada uno). Historia:
# 3->5 fue la Ronda 5 original (ver README): con el ladder adaptativo a la
# volatilidad, 5 escalones le fue mucho mejor a la reversion a la media que
# 3 (-$0.13 contra -$0.95 sobre los mismos 7 dias reales).
# Ronda 22 (2026-07-24): con el MIN_TP_USD=0.60 de Ronda 20 ya vigente,
# rebarrido 5->30 (reversion a la media SOLA). Mejora monotonica en TRAIN
# hasta 30 sin quiebre, pero TEST no confirma mas alla de 8 (pico en 8,
# despues baja y solo vuelve a acercarse sin superarlo recien en 30) - señal
# de que ganancias de TRAIN mas alla de 8 no generalizan. 5 -> 8:
#   TRAIN: 8 trades, 87.5% acierto, +$3.95 (antes +$3.67 con 5)
#   TEST:  13 trades, 92.3% acierto, +$11.20 (antes +$8.73 con 5)
# Mejora limpia en ambas mitades, sin cambiar el patron de trades de TRAIN.
# No se subio mas alla de 8 (el rebarrido no lo confirma en TEST).
TP_LEVELS=8
# Opcional: objetivo de ganancia EXPLICITO en USD para cada escalon de TP,
# separados por coma (debe tener TP_LEVELS valores, o se repite el ultimo).
# Ejemplo con TP_LEVELS=3: TP_TARGETS_USD=0.28,0.60,1.20 hace que cada
# escalon reserve su propio monto en dolares en vez de que solo el primero
# (MIN_TP_USD) tenga un valor en dolares y el resto sean multiplos de
# precio derivados de ese primero. Vacio (default) = comportamiento
# original, ya validado en el backtest de este README - no lo actives sin
# entender que cambia los niveles de salida reales.
TP_TARGETS_USD=

# ---- Ajuste de la estrategia (opcional - estos son los valores por defecto) ----
# Señal: reversion a la media con Bandas de Bollinger + RSI en el extremo.
# Tocar esto SIN backtestear primero es apostar a ciegas.
STRAT_RSI_OVERSOLD=25.0
STRAT_RSI_OVERBOUGHT=75.0
STRAT_BB_PERIOD=20
STRAT_BB_STD=2.0
STRAT_RSI_PERIOD=7
STRAT_ATR_PERIOD=14
# Spread maximo (en precio) para aceptar una señal - si el spread esta mas
# ancho que esto, cualquier setup se descarta (no vale la pena perseguirlo).
STRAT_MAX_SPREAD_PRICE=0.5
# ATR minimo para considerar que hay suficiente movimiento para que el
# primer TP tenga sentido frente al spread.
STRAT_MIN_ATR_PRICE=0.15
# Distancia del stop loss = ATR * este multiplicador (con un piso basado
# en MIN_TP_USD, ver core/strategy.py). Historia de este valor:
# - 4.0 (backtest original): venia de un proxy COMEX gold 1m, train/test
#   60/40 - valores mas bajos (~1.2) dejaban el stop demasiado cerca del
#   ruido normal de 1m y perdian dinero; 5.0 se veia mejor en train pero
#   se daba vuelta en test ahi (overfitting).
# - 3.5 (Ronda 15): barrido {2.0, 2.5, 3.0, 3.5, 4.0, 5.0} contra
#   data/gold_m1_7d_{train,test}.csv reales (7 dias M1, split 60/40),
#   mismos parametros de riesgo que Rondas 13-14 (balance=50, leverage=500,
#   risk_per_trade_usd=3, MIN_TP_USD=0.28, TP_LEVELS=5), con el cableado
#   real (build_strategy_from_settings). 3.5 fue el unico valor con PnL
#   POSITIVO en ambas mitades (TRAIN +$2.04/8 trades/87.5% win rate, TEST
#   +$2.76/9 trades/88.9% win rate) contra el baseline 4.0 (TRAIN -$2.19/3
#   trades, TEST +$1.20/2 trades) - mas trades Y positivo, no solo "menos
#   negativo". Valores mas chicos (2.0-3.0) suben el numero de trades
#   (16-53) pero dan PnL negativo en TRAIN; 5.0 dio CERO trades en este
#   dataset (todas las señales quedan rechazadas por el chequeo de Ronda
#   13 en core/risk_manager.py - el lote minimo del broker a esa distancia
#   de SL arriesga mas de lo que el presupuesto de riesgo permite). Ver el
#   docstring de core/strategy.py para el detalle completo.
# - Ronda 24 (2026-07-24): Ronda 23 midio que a 3.5 el cap del 5% de
#   balance (Ronda 13) rechaza 92% de las señales crudas de reversion a la
#   media en TEST - el lote minimo del broker implica mas riesgo real del
#   que el presupuesto (~$2.50) permite a esa distancia de SL. Hipotesis:
#   un SL mas chico reduce el riesgo real por el mismo lote minimo
#   (riesgo = lote * distancia_SL * valor_por_punto), asi que deberia dejar
#   pasar mas señales bajo el cap sin tocarlo. Rebarrido {1.0, 1.5, 2.0,
#   2.5, 3.0, 3.25, 3.5, 3.75, 4.0} sobre data/gold_m1_7d_{train,test}.csv,
#   reversion a la media SOLA, con MIN_TP_USD=0.60/TP_LEVELS=8 ya vigentes
#   (Rondas 20/22, el contexto que cambio desde que Ronda 15 tuneo este
#   valor) - risk_per_trade_usd=6.0, mismo cableado real
#   (build_strategy_from_settings). Se instrumento RiskManager.size_position
#   para medir "% de señales aceptadas" ademas del PnL, conectando directo
#   con el hallazgo de Ronda 23:
#     sl_atr | TRAIN trades/pnl/accept% | TEST trades/pnl/accept%
#     1.00   | 148 / -5.00  / 93.1%     | 91 / -20.20 / 72.2%
#     1.50   | 121 / -4.07  / 72.9%     | 64 / -10.95 / 50.4%
#     2.00   |  32 / -15.85 / 15.2%     | 54 /  -6.11 / 40.6%
#     2.50   |  26 /  -8.06 / 12.3%     | 29 /  -7.20 / 19.2%
#     3.00   |  16 /  -2.51 /  7.3%     | 14 /  -1.23 /  9.0%
#     3.25   |   9 /  +1.44 /  4.0%     | 14 /  +7.45 /  8.9%
#     3.50   |   8 /  +3.95 /  3.5%     | 13 / +11.20 /  8.2%  <- default
#     3.75   |   7 /  +2.29 /  3.1%     |  6 /  +8.06 /  3.7%
#     4.00   |   3 / -2.35  /  1.3%     |  2 /  +3.01 /  1.2%
#   Confirma el diagnostico de Ronda 23: achicar el SL SI sube fuerte el %
#   de señales aceptadas (1.3% a 3.5x hasta 93.1% a 1.0x en TRAIN) - el
#   mecanismo funciona como predice la formula de riesgo. Pero el PnL neto
#   empeora en TODOS los valores mas chicos que 3.5, en AMBAS mitades, sin
#   excepcion: mas señales pasan el cap pero son de peor calidad (el SL mas
#   angosto tambien te para por ruido normal de 1m con mas frecuencia, tal
#   como advertia el enunciado de esta ronda). 3.5 sigue siendo el unico
#   pico real en ambos datasets - ya optimo incluso con el MIN_TP_USD/
#   TP_LEVELS nuevos de Rondas 20/22, el rebarrido mas fino (3.25/3.75)
#   alrededor tampoco lo supera. SIN CAMBIO DE DEFAULT esta ronda: mas
#   señales aceptadas no es la metrica que importa si el PnL neto cae; el
#   cuello de botella del cap de Ronda 23 sigue ahi, pero resolverlo desde
#   el lado del SL no es rentable en este dataset - haria falta atacarlo
#   desde otro angulo (tamaño de cuenta, TP/SL ratio, o el propio cap,
#   fuera de alcance).
STRAT_SL_ATR_MULTIPLE=3.5
# Velas de 1m que hay que esperar tras cerrar un trade antes de aceptar
# la siguiente señal (evita reentrar en el mismo ruido inmediatamente).
STRAT_COOLDOWN_BARS=2
# Filtro de tendencia (ADX): si ADX >= este umbral, el mercado esta en
# tendencia fuerte y se descarta cualquier señal de reversion a la media
# (fue precisamente fadear una tendencia fuerte lo que produjo la secuencia
# de perdidas que quebro la cuenta en el backtest de 8 dias - ver README).
STRAT_ADX_PERIOD=14
STRAT_TREND_FILTER_ADX_THRESHOLD=35.0

# ---- Señales extra (opcionales, TODAS apagadas por defecto) ----
# Cinco señales M1 independientes mas, ademas de la reversion a la media de
# arriba - ideas adaptadas de un EA de referencia que me pasaron (ver el
# docstring de core/signals.py para el detalle completo de que se adapto y
# que se descarto a proposito: nada de grid/martingale sin stop-loss, cada
# señal de aca pasa por el mismo RiskManager y el mismo limite de
# RISK_PER_TRADE_USD que la reversion a la media, sin excepciones).
#
# Por que estan apagadas: un backtest real (7 dias de oro COMEX 1m, ver
# README "Ronda 4") encontro que las 5, cada una por separado, SI logran
# el objetivo de mas operaciones/dia (hasta ~26/dia contra ~3/dia de la
# reversion sola) pero con un resultado en dolares peor, no mejor, que la
# reversion a la media sola. Quedan en el codigo, probadas y documentadas,
# para quien quiera activar una, ajustarla y volver a correr el backtest -
# no para usarlas tal cual en una cuenta real todavia.
#
# Ronda 14: re-medida con split TRAIN/TEST real (data/gold_m1_7d_{train,
# test}.csv) y los parametros actuales de riesgo (balance $50, leverage
# 500, RISK_PER_TRADE_USD=3, MIN_TP_USD=0.28, TP_LEVELS=5), cada señal
# activada SOLA junto a la reversion a la media (build_strategy_from_settings,
# no objetos armados a mano). Confirma Ronda 4 con numeros nuevos - todas
# ganan mas operaciones pero pierden dinero en AMBAS mitades (win rate alto,
# 61-79%, pero perdida promedio >> ganancia promedio, mismo patron ya visto
# en MACrossGridStrategy/Ronda 11: TP chico vs SL ancho basado en ATR):
#   momentum_cross:     TRAIN 49 trades -$16.47 (37.8% dd) | TEST 38 trades -$4.69 (31.4% dd)
#   rsi_hysteresis:     TRAIN 36 trades -$21.70 (45.6% dd) | TEST 60 trades -$2.50 (29.1% dd)
#   directional_candle: TRAIN 153 trades -$36.79 (75.0% dd) | TEST 289 trades -$32.74 (75.0% dd)
#   session_open:       TRAIN 31 trades -$12.41 (31.5% dd) | TEST 15 trades -$5.15 (11.8% dd)
#   asian_breakout:     TRAIN 13 trades -$6.49 (15.4% dd)  | TEST 2 trades (no disparo, cae a la reversion a la media base)
# Ninguna paso siquiera el filtro de TRAIN (PnL positivo), asi que ninguna
# se llego a evaluar por overfitting en TEST - se quedan apagadas. No se
# investigo correlacion de regimen (detect_regime_series) porque ese paso
# solo aplica a señales que primero validan en ambas mitades.
#
# Ronda 17: la pregunta pendiente de la Ronda 14 - ¿algun regimen de
# core/regime.py (detect_regime_series: name en {trend, range, volatile,
# quiet, unknown} - la misma clasificacion que ya excluye ma_grid/
# quantum_queen durante "volatile" en CompositeStrategy) aisla un
# subconjunto rentable de alguna de las 6 señales, en vez de medirlas
# mezcladas sobre todo el dataset? Mismo backtest que la Ronda 14
# (build_strategy_from_settings, señal SOLA + reversion a la media,
# RISK_PER_TRADE_USD=3 y STRAT_SL_ATR_MULTIPLE=3.5 de la Ronda 15 ya
# vigentes en .env), pero cada trade etiquetado por el regimen vigente en
# su vela de apertura (detect_regime_series sobre el mismo dataset,
# cruzado por indice de barra) en vez de solo sumar el PnL total. La
# reimplementacion de run_backtest() usada para extraer el regimen por
# trade se verifico byte a byte contra la funcion real (mismos trades/PnL/
# drawdown agregados en los 12 casos señal x split) antes de confiar en el
# desglose. Nota: los agregados de esta ronda ya no coinciden con los de
# la Ronda 14 porque STRAT_SL_ATR_MULTIPLE cambio de ahi para aca (Ronda
# 15); ej. asian_breakout paso de "TEST 2 trades, no disparo" a TEST 9
# trades +$2.76 - la señal dispara mas seguido con el SL mas angosto, eso
# es deriva de config, no un hallazgo nuevo.
#
# "range" domina el dataset (23-165 trades por señal) y pierde dinero en
# AMBAS mitades para las 6 señales sin excepcion (ej. directional_candle
# range: TRAIN 88 trades -$15.55, TEST 165 trades -$35.10) - el problema
# de fondo (TP chico del ladder de reversion vs SL ancho basado en ATR) no
# es un artefacto de mezclar regimenes, es real dentro del regimen mas
# comun. Ningun bucket de regimen con muestra razonable resulta rentable
# en TRAIN y se sostiene en TEST a la vez:
#   momentum_cross "trend":  TRAIN 10 trades +$4.13 (90% win)  | TEST 8 trades  -$2.14 (75% win) - se da vuelta en test
#   rsi_hysteresis "trend":  TRAIN 3 trades  +$2.07 (100% win) | TEST 4 trades  -$4.45 (50% win) - se da vuelta, n chico
#   quantum_queen "trend":   TRAIN 5 trades  +$0.64 (80% win)  | TEST 11 trades -$0.72 (82% win) - se da vuelta
#   asian_breakout "trend":  TRAIN 2 trades  +$1.27 (100% win) | TEST 4 trades  +$3.53 (100% win) - signo positivo en
#     ambas mitades pero n=2/4 (la señal entera solo dispara 15/9 veces en todo train/test) - demasiado chico para
#     distinguir de ruido, no cuenta como hallazgo
#   directional_candle "volatile": TRAIN 10 trades -$0.48 (70% win) | TEST 19 trades +$2.65 (79% win) - el bucket mas
#     cercano a breakeven de los 6, pero TRAIN sigue en rojo asi que no pasa ni el primer filtro (PnL positivo en
#     TRAIN antes de mirar TEST)
# Conclusion: ningun regimen aisla un subconjunto genuinamente rentable y
# validado train+test con muestra decente para ninguna de las 6 señales.
# Ninguna se activa por regimen esta ronda - hallazgo negativo/insight-only,
# documentado aca sin tocar codigo ni valores (CompositeStrategy sigue
# igual: las 6 señales apagadas, sin gate de regimen nuevo para ellas).
STRAT_ENABLE_MOMENTUM_CROSS=false
STRAT_ENABLE_RSI_HYSTERESIS=false
STRAT_ENABLE_DIRECTIONAL_CANDLE=false
STRAT_ENABLE_SESSION_OPEN=false
STRAT_ENABLE_ASIAN_BREAKOUT=false

# Sexta señal extra, NO adaptada del EA de referencia - pedida directamente
# por el usuario para sumar frecuencia de trades: mira la ULTIMA vela M15 ya
# CERRADA (resample de M1, nunca la vela M15 en formacion - mismo principio
# de "solo velas cerradas" que la Ronda 8 ya aplico a M1) y usa su cierre vs
# apertura como contexto de compra/venta para M1. Backtest real (ver README
# "Ronda 9"): default queda en false, ver esa seccion para el numero exacto
# y por que.
STRAT_ENABLE_M15_TREND=false

# RSI/ATR usados SOLO por las señales extra de arriba (no tocan
# STRAT_RSI_PERIOD/STRAT_ATR_PERIOD, que son de la reversion a la media).
STRAT_COMPOSITE_RSI_PERIOD=14
STRAT_COMPOSITE_ATR_PERIOD=14

STRAT_MOMENTUM_SL_ATR_MULTIPLE=2.0

STRAT_RSI_HYSTERESIS_SL_ATR_MULTIPLE=2.0
STRAT_RSI_HYSTERESIS_UPPER=52.0
STRAT_RSI_HYSTERESIS_LOWER=48.0

STRAT_DIRECTIONAL_CANDLE_SL_BUFFER_ATR_MULT=0.3

# Ventanas de sesion en hora UTC (Londres y Nueva York) para
# STRAT_ENABLE_SESSION_OPEN.
STRAT_SESSION_SL_ATR_MULTIPLE=2.0
STRAT_SESSION_LONDON_START_HOUR=7
STRAT_SESSION_LONDON_END_HOUR=10
STRAT_SESSION_NY_START_HOUR=12
STRAT_SESSION_NY_END_HOUR=16

# Rango asiatico (para armar el rango) y ventana de ruptura (para operarla),
# en hora UTC, para STRAT_ENABLE_ASIAN_BREAKOUT.
STRAT_ASIAN_SL_ATR_MULTIPLE=2.0
STRAT_ASIAN_RANGE_START_HOUR=0
STRAT_ASIAN_RANGE_END_HOUR=7
STRAT_ASIAN_BREAKOUT_START_HOUR=7
STRAT_ASIAN_BREAKOUT_END_HOUR=10
STRAT_ASIAN_BREAKOUT_BUFFER_PCT=0.05

# Para STRAT_ENABLE_M15_TREND: multiplicador de ATR (M1) para el stop, y que
# tan chico puede ser el cuerpo de la vela M15 (como fraccion de su rango
# high-low) antes de tratarla como doji/lateral y no dar señal.
STRAT_M15_TREND_SL_ATR_MULTIPLE=2.0
STRAT_M15_TREND_MIN_BODY_RANGE_RATIO=0.1

# Septima señal extra: SMA(9)/SMA(26) cross + espera fija de 2 velas + filtro
# RSI permisivo (70/30), portada de un EA MQL5 que paso el usuario
# ("ScalpMaster Pro v1.0") pidiendo portarlo "tal cual". El original abre
# posiciones con SL=0 (sin stop-loss real, solo un trailing que arranca
# recien despues de tocar el primer nivel de su grid de TP) - eso NO se
# porto, se le agrego un SL real basado en ATR (ver core/signals.py,
# MACrossGridStrategy). Pensada para velas M15 nativas, no M1 (ver README
# "Ronda 10" para el resultado real del backtest antes de activarla).
STRAT_ENABLE_MA_GRID=true
STRAT_MA_GRID_SL_ATR_MULTIPLE=3.0
STRAT_MA_GRID_FAST_PERIOD=9
STRAT_MA_GRID_SLOW_PERIOD=26
STRAT_MA_GRID_ENTRY_WAIT_BARS=2
STRAT_MA_GRID_RSI_OVERBOUGHT=70.0
STRAT_MA_GRID_RSI_OVERSOLD=30.0
# ADX(14) minimo para permitir un cruce (0 = sin filtro). Un cruce de SMA es
# señal de TENDENCIA - sin este filtro dispara igual en mercado lateral/ruido
# y eso es exactamente lo que lo hundio en M1 real (ver README "Ronda 11":
# -$29.24 con 78.4% de acierto, ganancia promedio +$0.14 vs perdida promedio
# -$3.54). ADX>=20 no lo vuelve rentable en M1 (sigue perdiendo en TEST) pero
# reduce perdida y drawdown ~5-6x de forma honesta y medida - no es una
# solucion completa, es una reduccion de riesgo real.
STRAT_MA_GRID_MIN_ADX=20.0

# Ronda 21: reversion completa del hallazgo de arriba. Ronda 20 subio
# MIN_TP_USD 0.28 -> 0.60 (ver mas arriba, "Gestion de riesgo") atacando el
# mismo techo TP/SL que hundio a ma_grid en Ronda 11 - re-medida ma_grid
# SOLA con ese MIN_TP_USD=0.60 ya vigente sobre
# data/gold_m1_7d_{train,test}.csv:
#   TRAIN: 28 trades, 89.3% acierto, +$11.72 (antes -$29.24 con MIN_TP=0.28)
#   TEST:  15 trades, 80.0% acierto, +$3.19
# Rentable en AMBAS mitades, sin cambiar ningun otro parametro de ma_grid
# (STRAT_MA_GRID_MIN_ADX=20 de Ronda 11 se mantiene, sigue siendo el filtro
# de tendencia que evita que dispare en lateral/ruido). Se activa por
# defecto - primera señal extra (de 9 probadas: Ronda 4/14 x6, Ronda 19 x2,
# Ronda 10/11 ma_grid) que valida train+test sin reservas. Re-medida
# tambien el resto de las 6 señales de Ronda 14 con este MIN_TP_USD nuevo
# (momentum_cross, rsi_hysteresis, directional_candle, session_open,
# asian_breakout, quantum_queen) - todas siguen perdiendo en ambas mitades,
# el TP mas grande no las salva a ellas, solo a ma_grid. Sin cambios ahi.
#
# Ronda 22 (2026-07-24): reversion a la media + ma_grid COMBINADAS (el
# default real desde Ronda 21, nunca medido junto hasta ahora), con
# TP_LEVELS=8 ya vigente:
#   TRAIN: 26 trades, 92.3% acierto, +$14.90
#   TEST:  15 trades, 80.0% acierto, +$3.19 (identico a ma_grid SOLA)
# El TEST combinado da EXACTO el mismo numero de trades y PnL que ma_grid
# sola (Ronda 21) - la reversion a la media parece no aportar NINGUN trade
# propio en la ventana de TEST cuando ma_grid esta activa junto (vs sus
# 12 trades/+$8.73 sola). Posible interferencia de prioridad/exclusividad
# entre sub-señales de CompositeStrategy (core/signals.py) - no investigado
# a fondo esta ronda por tiempo, queda abierto para una Ronda futura. No es
# una emergencia (el combo sigue siendo positivo en ambas mitades) pero es
# una pista real de que se esta perdiendo oportunidad de trade, no solo un
# numero cosmetico.
#
# Ronda 23 (2026-07-24): investigada la causa raiz de arriba. Se leyo
# CompositeStrategy entera (core/signals.py) y se replayo barra por barra
# sobre TEST con un harness instrumentado (no comiteado, uso unico) que
# registra, en cada barra, que devuelve generate_signal, si RiskManager.
# size_position() acepta esa señal, y por que no cuando la rechaza -
# comparando una corrida SOLA de la reversion a la media (su propio
# cooldown, sin ma_grid) contra la corrida COMBINADA real.
#
# Resultado: NO es un bug de orden de prioridad ni de cooldown compartido
# en CompositeStrategy. La reversion a la media SIGUE teniendo prioridad
# (se chequea primero, linea ~910) y ma_grid nunca le "roba el turno" en
# el sentido de exclusividad de señal. Sobre 116 barras donde una
# reversion a la media aislada (su propio cooldown) habria disparado una
# señal valida en la ventana de TEST, 107 no terminan como trade abierto
# en la corrida combinada:
#   - 101/107: la señal SI se genera igual (CompositeStrategy la devuelve)
#     pero RiskManager.size_position() la rechaza con el mismo mensaje ya
#     documentado en Rondas 14/17/19/20 ("Volatilidad demasiado alta para
#     el lote minimo del broker... por encima del limite efectivo de
#     2.50 USD, ya con el cap del 5% del balance de Ronda 13 aplicado") -
#     el techo estructural de siempre, no algo nuevo.
#   - 6/107: bloqueadas porque ya habia una posicion abierta (el motor
#     real solo sostiene 1 posicion simultanea - backtest.py solo llama a
#     generate_signal cuando open_pos is None, mecanica identica al motor
#     en vivo, fuera de CompositeStrategy).
# Medido tambien SOLA (sin ma_grid en absoluto): de 159 disparos crudos de
# señal en la misma ventana de TEST, 146 (92%) se rechazan por el MISMO
# techo estructural balance-dependiente, y solo 13 llegan a abrir posicion
# - o sea, la reversion a la media YA descarta la enorme mayoria de sus
# propias señales por este motivo incluso corriendo sola. La causa real
# de por que el COMBO termina con una poblacion distinta de esas pocas
# señales aceptadas es que reversion a la media y ma_grid comparten UN
# solo balance de cuenta que compone con cada trade cerrado - el cap
# efectivo de RiskManager es 5% del balance ACTUAL (Ronda 13), asi que en
# que barra especifica ese 5% alcanza para el lote minimo del broker
# depende de la trayectoria de balance hasta ese punto, y esa trayectoria
# es distinta entre la corrida sola y la combinada (los trades de ma_grid
# intercalados mueven el balance en puntos donde la corrida sola no
# tendria ningun trade). ma_grid, con una distancia de SL tipicamente mas
# angosta, nunca choca este techo en esta ventana - por eso su cuenta de
# trades queda identica entre sola y combinada, mientras la de reversion a
# la media se reordena entre "cual señal exacta pasa el cap" segun el
# balance de ese momento.
#
# Conclusion: comportamiento intencional/correcto del motor de riesgo, no
# un bug de CompositeStrategy - es la consecuencia esperada de que dos
# estrategias compartan un solo capital gestionado por RiskManager (Ronda
# 13, MAX_RISK_FRACTION_OF_BALANCE=0.05) mas el limite de 1 posicion
# simultanea (mecanica real del motor). Arreglarlo de raiz implicaria
# tocar core/risk_manager.py (fuera de alcance, superficie protegida) o
# rediseñar el modelo de capital para llevar balances virtuales separados
# por sub-estrategia (cambio de arquitectura grande, no quirurgico) - se
# documenta como hallazgo, no se implementa. Sin cambios de codigo esta
# ronda.

# Ronda 19: octava y novena señal extra, esta vez NO adaptadas del EA de
# referencia - patrones de vela japonesa clasicos (engulfing alcista/bajista,
# pin bar / hammer / shooting star), pedidos explicitamente por el dueño del
# proyecto tras 3 rondas seguidas (16-18) sin mejora verificada barriendo
# parametros/señales ya existentes (umbral de parada de la metodologia
# alcanzado - toca explorar espacio nuevo, no repetir el agotado). Tesis:
# la reversion a la media validada (core/strategy.py) dispara con cualquier
# cierre mas alla de la banda de Bollinger + RSI extremo, incluso si esa
# vela de cierre es debil/indecisa. Un patron de vela de reversion clasico
# (engulfing: 2 velas, el cuerpo de la segunda revierte y sobrepasa
# completamente el de la primera; pin bar: 1 vela con mecha larga de rechazo
# y cuerpo chico) es una confirmacion mas especifica de reversion real de
# flujo de ordenes - se pide el MISMO contexto de extremo (banda de
# Bollinger o RSI, ver core/signals.py::EngulfingReversalStrategy/
# PinBarReversalStrategy) pero el gate es la forma de la vela, no un umbral
# de RSI arbitrario. Stop estructural (mas alla del low/high de la vela de
# señal + buffer de ATR chico), igual que DirectionalCandleStrategy.
#
# Backtest real (build_strategy_from_settings, señal SOLA + reversion a la
# media, mismos parametros de riesgo vigentes: RISK_PER_TRADE_USD=3,
# STRAT_SL_ATR_MULTIPLE=3.5, MIN_TP_USD=0.28, TP_LEVELS=5 - Rondas 13-15).
# Se probaron ambos datasets disponibles con split TRAIN/TEST
# (data/gold_m1_7d_{train,test}.csv, 7 dias M1; data/gold_history_m15_{train,
# test}.csv, historial M15 mas largo) para decidir que timeframe es
# apropiado - con estos mismos parametros de riesgo la reversion a la media
# BASE (sin ningun extra) ya da 0 trades en M15 (el lote minimo del broker
# a esa escala de precio/ATR excede el presupuesto de riesgo, mismo
# mecanismo de rechazo de core/risk_manager.py que Ronda 15 documento para
# SL_ATR_MULTIPLE=5.0) - M15 no es un dataset valido para comparar con
# estos parametros, M1 (el timeframe que el motor en vivo realmente opera)
# es el unico resultado que cuenta aca:
#   engulfing: TRAIN 14 trades -$0.98 (71.4% acierto, 6.1% dd) | TEST 12 trades +$4.25 (91.7% acierto, 6.2% dd)
#   pin_bar:   TRAIN 39 trades -$3.92 (69.2% acierto, 20.1% dd) | TEST 21 trades -$8.19 (57.1% acierto, 26.2% dd)
# pin_bar pierde dinero en ambas mitades sin ambiguedad - descartada, igual
# que las 7 señales extra anteriores. engulfing es el caso interesante: TEST
# es claramente positivo (+$4.25, 91.7% acierto) pero TRAIN queda en rojo
# (-$0.98, aunque cerca de breakeven) - la metodologia de este proyecto
# corta ACA (paso 2, "si no mejora medible/consistentemente en TRAIN, se
# descarta ahi mismo, no pasa a test"), a proposito para no elegir a dedo el
# numero de TEST que mas gusta cuando TRAIN ya dijo que no. Se documenta el
# resultado completo de TEST igual (no se esconde el numero positivo) pero
# NO se activa por defecto solo por eso - mismo patron estructural que las
# 7 señales anteriores (ver Ronda 14): el ladder de TP esta anclado chico
# (MIN_TP_USD=0.28) mientras el stop-loss real usado es
# max(estructural, 1.5x la distancia de TP1) - ningun patron de vela nuevo
# escapa ese piso de 1.5x, asi que incluso una señal con acierto genuino
# alto (69-91% aca) necesita un acierto MUY alto y sostenido para superar
# perdidas ocasionales 1.5x+ mas grandes que la ganancia tipica; con solo
# 12-39 operaciones por mitad ninguna de las dos junta muestra suficiente
# para confiar en que el acierto observado se sostiene. Ambas quedan
# apagadas por defecto - hallazgo negativo documentado, no se esconde.
STRAT_ENABLE_ENGULFING=false
STRAT_ENGULFING_SL_BUFFER_ATR_MULT=0.3
STRAT_ENGULFING_RSI_OVERSOLD=30.0
STRAT_ENGULFING_RSI_OVERBOUGHT=70.0
STRAT_ENGULFING_BB_TOLERANCE_ATR_MULT=0.3
STRAT_ENABLE_PIN_BAR=false
STRAT_PIN_BAR_SL_BUFFER_ATR_MULT=0.3
STRAT_PIN_BAR_RSI_OVERSOLD=30.0
STRAT_PIN_BAR_RSI_OVERBOUGHT=70.0
STRAT_PIN_BAR_BB_TOLERANCE_ATR_MULT=0.3
STRAT_PIN_BAR_MIN_WICK_BODY_RATIO=2.0
STRAT_PIN_BAR_MAX_OPPOSITE_WICK_RATIO=0.5
STRAT_PIN_BAR_MIN_CLOSE_POSITION_RATIO=0.6

# Cuantas velas M1 pide el motor al bridge en cada poll. 200 alcanzaba solo
# para la reversion a la media; las señales extra de arriba (EMA50 en M5,
# rango asiatico) necesitan varias horas de historial para calentar bien -
# sigue siendo UN solo pedido al bridge por poll, nomas con mas datos.
CANDLE_HISTORY_COUNT=600

# ---- Modo de ejecucion ----
# false = envia ordenes reales a la cuenta MT5 configurada arriba.
# Este proyecto se instala para operar en real; el backtest es siempre
# separado y de solo lectura.
DRY_RUN=false

# ---- Filtro IA opcional (OpenRouter) ----
# Solo puede confirmar o vetar una señal ya generada; no puede cambiar lote,
# SL, TP ni limites de riesgo. openrouter/free usa un modelo gratuito
# disponible y la consulta se hace solo cuando existe una señal candidata.
# Ronda 18 conto cuantas llamadas reales dispararia un harness de backtest
# del cerebro IA (scripts/count_ai_brain_signals.py, cero red, solo cuenta
# bars con señal deterministica ya generada) y encontro 304 en M15
# train+test, por encima del presupuesto de ~150-200 acordado - paro sin
# implementar el harness. Ronda 25 (2026-07-24) recontó con la config
# vigente hoy (MIN_TP_USD=0.60, TP_LEVELS=8, STRAT_ENABLE_MA_GRID=true de
# Rondas 20-22, todos posteriores a Ronda 18): el numero de M15 train+test
# da EXACTO el mismo 304 (181+123, identico bar por bar) - esos tres
# cambios no movieron nada la frecuencia de señal deterministica en M15.
# Sigue por encima del presupuesto: no se implementa el harness esta
# ronda tampoco, mismo criterio de Ronda 18.
AI_BRAIN_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_BRAIN_TIMEOUT_MS=6000
AI_BRAIN_MAX_CALLS_PER_DAY=40
AI_SUPERVISOR_ENABLED=false
OPENROUTER_SUPERVISOR_API_KEY=
OPENROUTER_SUPERVISOR_MODEL=openrouter/free
AI_SUPERVISOR_TIMEOUT_MS=6000
AI_SUPERVISOR_MAX_CALLS_PER_DAY=24

# ---- Dashboard ----
DASHBOARD_DB_PATH=data/trades.db

# Cuantos dias de account_snapshots (una fila por cada poll del motor, no
# solo por operacion) se conservan antes de que el motor los borre solos
# (chequeo cada una hora). Sin esto la tabla crece sin limite en una
# instancia que corre semanas/meses.
SNAPSHOT_RETENTION_DAYS=30
